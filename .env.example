# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Postgres ───────────────────────────────────────────────────────────────
# Local dev compose default:
POSTGRES_DSN=postgresql://ryan:ryan@localhost:5432/ryanclone
PGVECTOR_DIM=1024

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Persona LLM (one of OpenAI / Anthropic required for chat) ─────────────
# LLM_PROVIDER picks the active backend; either key alone is enough to boot.
LLM_PROVIDER=openai
PERSONA_MODEL=gpt-4o-mini
PERSONA_MAX_TOKENS=1024
PERSONA_TEMPERATURE=0.6

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Embeddings (BGE-M3, self-hosted) ───────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps
EMBEDDING_CACHE_DIR=.cache/embeddings

# ── RAG tuning ─────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=10
RETRIEVAL_TOP_K_FINAL=5

# ── Voice (Phase 2 — leave blank until ready) ──────────────────────────────
VOICE_ENABLED=false
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Memory (Phase 3) ───────────────────────────────────────────────────────
MEM0_ENABLED=false

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=300

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Frontend ───────────────────────────────────────────────────────────────
# Where the browser fetches the API. In dev with Next rewrites this can stay
# as the default; in prod with separate hosts use https://api.ryangomez.dev
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_API_URL=http://api:8000

# ── Backups (Hetzner Storage Box) ──────────────────────────────────────────
SBOX_USER=
SBOX_HOST=
SBOX_PATH=/backups/ryan-clone
